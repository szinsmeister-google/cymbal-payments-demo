# ==============================================================================
# Cymbal Payments — Cloud Bigtable & Cloud Spanner Graph Demo Configuration
# Copy this file to `.env` and fill in your Google Cloud project details.
# ==============================================================================

# Required: Your Google Cloud Project ID
PROJECT_ID=your-gcp-project-id

# Primary Region & Zone (Bigtable, Spanner, BigQuery, Cloud Run, Knowledge Catalog)
REGION=us-central1
ZONE=us-central1-a

# Demo 1: Cloud Bigtable (Intelligent Acceptance)
BT_INSTANCE=cymbal-payments-prod
BT_CLUSTER=cymbal-payments-c1

# Demo 2: Cloud Spanner Graph (Zero-ETL Fraud Rings & T+0 Settlement)
SPANNER_INSTANCE=cymbal-payments-graph
SPANNER_DB=settlement_and_fraud_db
SPANNER_GRAPH=cymbal_fraud_and_settlement_graph

# Federated Analytics & Governance (BigQuery + Knowledge Catalog)
BQ_DATASET=cymbal_payments_warehouse
BQ_SPANNER_CONN=cymbal-spanner-conn
GLOSSARY_ID=cymbal-payments-glossary

# Custom Apps & Cloud Run Dual MCP Server
CLOUD_RUN_SERVICE=cymbal-payments-bt-bridge

# Optional: Gemini Enterprise Engine ID (only needed for 05_setup_agents_and_connectors.py --with-gemini-enterprise)
GE_ENGINE_ID=cymbal-payments-enterprise-hub
# Optional: Deployed Cloud Run / API Gateway base URL for MCP connectors
MCP_BASE_URL=
